{
  "name": "connecteat",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "dashboard",
    "mobile",
    "firebase/functions"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:dashboard": "npm --workspace dashboard run dev",
